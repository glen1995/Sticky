{
    "manifest_version": 3,
    "name": "Sip — Water Reminder",
    "version": "1.0.0",
    "description": "A friendly animated bottle that helps you remember to drink water.",
    "permissions": [
        "alarms",
        "notifications",
        "storage"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "service-worker.js"
    },
    "action": {
        "default_title": "Sip — Water Reminder",
        "default_popup": "popup/popup.html"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ]
}